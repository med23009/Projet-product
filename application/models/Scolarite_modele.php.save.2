function get_etudiant_or($anneeCourante){
  $etudiant = array();
$sessioncourante =$this->get_session_courante();
           $anneeCourante = $sessioncourante['annee'][0];
           $semestreCourant = $sessioncourante['semestre'][0];
           if( $semestreCourant=3 ){
               $anneeCourante=$anneeCourante;
            }
            if($semestreCourant=1){  
                $anneeCourante=$anneeCourante-1;
            }
        $query = $this->db->query("SELECT Distinct d.`matriculeEtudiant`, `nom`,`prenom` FROM `etudiant` e join dossieretudiant d on(e.matriculeEtudiant=d.matriculeEtudiant)" 
            ."where `annee`=$anneeCourante   and `idProgramme`='TC'  order by `matriculeEtudiant`;");
 //and e.matriculeEtudiant not in (SELECT `matriculeEtudiant` from dossieretudiant WHERE `idProgramme`!='TC') order by `matriculeEtudiant`;");
        if ($query->num_rows() > 0) {
            foreach ($query->result_array() as $row) {
                $etudiant['matricule'][] = $row['matriculeEtudiant'];
                $etudiant['nom'][] = $row['nom'];
                $etudiant['prenom'][] = $row['prenom'];
            }
        }
        return $etudiant;



}
