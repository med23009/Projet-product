    function isValideHr($hr)
    {
        $hr = str_replace(",", ".", $hr);
        if(is_numeric($hr) && $hr<=90 && $hr>=0)
        {
            if(strlen($hr)<=5)
                return $hr;
            else
            {
                return NULL;
            }
        }
        else
        {
            return NULL;
        }
    }
