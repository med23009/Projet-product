    /*
     * fonction pour compter le nombre de match d'un string dans les valeurs d'un tableau
     */
    function countWhere($tableau,$string)
    {
        $counter = 0;
        for($i=0;$i<count($tableau);$i++)
        {
            if($tableau[$i]==$string)
                $counter++;
        }
        return $counter;
    }
