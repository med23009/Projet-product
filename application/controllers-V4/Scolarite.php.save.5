    /*
     * Fonction isValid pour valider la note qui doit etre entre 0 et 20 et remplacer les virgules par des .
     */

    function isValide($note) 
    {
       $note = str_replace(",", ".", $note);
        if(is_numeric($note) && $note<=20 && $note>=0)
        {
            if(strlen($note)<=5)
                return $note;
            else
                return NULL;
        }
        else
            return NULL;
    }

